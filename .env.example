# Copy this file to .env and fill values from the EAT/Berezka cabinet.
# Never commit real tokens.
EAT_API_TOKEN=
EAT_EXT_SYSTEM=
EAT_AUTH_HEADER=Authorization
EAT_AUTH_SCHEME=Bearer
EAT_MAX_DETAILS=100

# Optional: override the public Tender.Pro API key from tender_parser/config.py.
TENDER_PRO_API_KEY=
