# Copy this file to .env and fill values from the EAT/Berezka cabinet.
# Never commit real tokens.
EAT_API_TOKEN=
EAT_EXT_SYSTEM=
EAT_AUTH_HEADER=Authorization
EAT_AUTH_SCHEME=Bearer
EAT_MAX_DETAILS=100

# Optional: override the public Tender.Pro API key from tender_parser/config.py.
TENDER_PRO_API_KEY=

# Optional Telegram notifications for new actionable tenders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ITEMS=10
TELEGRAM_TIMEOUT_SECONDS=10

# Download public EIS attachments for newly found actionable tenders.
DOWNLOAD_TENDER_DOCUMENTS=0
DOWNLOAD_MAX_TENDERS=10
DOWNLOAD_MAX_DOCUMENTS_PER_TENDER=10
DOWNLOAD_MAX_FILE_MB=25
DOWNLOAD_TIMEOUT_SECONDS=20

# Optional path relative to the project folder. Default: config/Настройки_поиска.xlsx
SEARCH_CONFIG_PATH=config/Настройки_поиска.xlsx
