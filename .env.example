# Copy this file to .env and fill values from the EAT/Berezka cabinet.
# Never commit real tokens.
EAT_API_TOKEN=
EAT_EXT_SYSTEM=
EAT_AUTH_HEADER=Authorization
EAT_AUTH_SCHEME=Bearer
EAT_MAX_DETAILS=100
EAT_RATE_LIMIT_RETRIES=3
EAT_RATE_LIMIT_BACKOFF_SECONDS=5
EAT_RATE_LIMIT_MAX_DELAY_SECONDS=60

# Optional: override the public Tender.Pro API key from tender_parser/config.py.
TENDER_PRO_API_KEY=

# Official anonymous TEK-Torg SOAP feed. No token or cabinet login is needed.
# By default only Crimea, Sevastopol, Zaporozhye and Kherson records are kept.
TEKTORG_SECTION_CODES=44fz,zakupki,market,interrao,nornikel
TEKTORG_LOOKBACK_HOURS=48
TEKTORG_PAGE_SIZE=100
TEKTORG_MAX_PAGES_PER_SECTION=10
TEKTORG_TIMEOUT_SECONDS=60
TEKTORG_TARGET_ONLY=1

# Read-only bridge to the synchronized I-T-P catalog.
TENDER_SUPPLIER_API_URL=
TENDER_SUPPLIER_API_TOKEN=

# Optional read-only path to a tender database maintained by another project copy.
# Normally empty when the collector and the interactive agent share this repository.
TENDER_DATABASE_PATH=

# Read-only bridge to the owner's climate hub (four supplier sources).
TENDER_CLIMATE_API_URL=
TENDER_CLIMATE_API_TOKEN=

# Preferred private connection: local MCP calls Content Factory through SSH.
TENDER_CLIMATE_SSH_HOST=
TENDER_CLIMATE_SSH_PORT=22
TENDER_CLIMATE_SSH_BIND_ADDRESS=
TENDER_CLIMATE_SSH_KEY=
TENDER_CLIMATE_REMOTE_DIR=/opt/content-factory

# Generic aliases for universal private-price search.
TENDER_CATALOG_SSH_HOST=
TENDER_CATALOG_SSH_PORT=22
TENDER_CATALOG_SSH_BIND_ADDRESS=
TENDER_CATALOG_SSH_KEY=
TENDER_CATALOG_REMOTE_DIR=/opt/content-factory

# Optional Telegram notifications for new actionable tenders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPPLIER_TELEGRAM_CHAT_ID=
# Optional comma-separated Telegram user IDs allowed to upload supplier prices.
SUPPLIER_TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_ITEMS=10
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_SEND_DAILY_REPORT=1
TELEGRAM_SEND_EXCEL=1
TELEGRAM_COMMANDS_ENABLED=0

# Optional permanent Google Sheets registry. Share the sheet with the service account email.
GOOGLE_SHEETS_ENABLED=0
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_URL=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SHEETS_TIMEOUT_SECONDS=30

# Feed newly collected/enriched customers into the separate tender mailing queue.
# The same service account must have editor access to that spreadsheet.
TENDER_OUTREACH_QUEUE_SYNC_ENABLED=0
TENDER_OUTREACH_SPREADSHEET_ID=
TENDER_OUTREACH_CAMPAIGN_ID=tender-intro-v1
TENDER_OUTREACH_SYNC_TIMEOUT_SECONDS=30

# Accumulate customers from the full tender history and enrich missing public
# business contacts from exact EIS notice/organization pages.
CUSTOMER_CONTACTS_ENABLED=1
CUSTOMER_CONTACTS_MAX_PER_RUN=25
CUSTOMER_CONTACTS_TIMEOUT_SECONDS=25
CUSTOMER_CONTACTS_CACHE_PATH=data/customer_contacts.json

# Download public EIS attachments for newly found actionable tenders.
DOWNLOAD_TENDER_DOCUMENTS=0
DOWNLOAD_MAX_TENDERS=10
DOWNLOAD_MAX_DOCUMENTS_PER_TENDER=10
DOWNLOAD_MAX_FILE_MB=25
DOWNLOAD_TIMEOUT_SECONDS=20

# Optional path relative to the project folder. Default: config/Настройки_поиска.xlsx
SEARCH_CONFIG_PATH=config/Настройки_поиска.xlsx

# Resolve shortlisted Rostender cards to public EIS/ETP identifiers.
ROSTENDER_RESOLUTION_ENABLED=1
ROSTENDER_RESOLUTION_LIMIT=50
ROSTENDER_RESOLUTION_DELAY_SECONDS=0.75
ROSTENDER_RESOLUTION_TIMEOUT_SECONDS=20
ROSTENDER_RESOLUTION_NEGATIVE_TTL_HOURS=24
ROSTENDER_RESOLUTION_POSITIVE_TTL_HOURS=12
ROSTENDER_RESOLUTION_CACHE_PATH=data/rostender_resolution_cache.json

# Freshness limit for the isolated RTS last-good snapshot consumed by profile fast.
RTS_BACKGROUND_MAX_SNAPSHOT_AGE_HOURS=168

# Legacy EIS FTP/manual XML import. The live FTP service was closed after 01.07.2024;
# keep disabled unless processing already downloaded archives. Current live collection uses HTML.
EIS_XML_ENABLED=0
EIS_XML_STATE_PATH=data/eis_regional_xml_state.json
EIS_XML_IMPORT_DIR=imports/eis_xml

# Personal Telegram equipment assistant. Keep all real values only in .env.
TELEGRAM_AGENT_BOT_TOKEN=
TELEGRAM_AGENT_ALLOWED_USER_IDS=
TELEGRAM_MAX_VOICE_BYTES=20971520
TELEGRAM_CODEX_SESSION_ID=
TELEGRAM_WHISPER_MODEL=small
# Optional explicit path. Normally the installed Codex CLI is detected automatically.
CODEX_CLI_PATH=
